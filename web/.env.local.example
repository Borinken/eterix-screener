# Copy to .env.local for local dev, and set the same two vars in the Vercel
# project's Environment Variables (Settings -> Environment Variables).
# Both come from the Supabase project dashboard: Settings -> API.
#
# SUPABASE_SERVICE_ROLE_KEY is used ONLY in server-side API routes (never
# sent to the browser) so it's safe to bypass RLS with it here.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
